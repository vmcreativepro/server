# Which image backend to use: stub | replicate | stability | openai
IMAGE_PROVIDER=stub
PORT=4000

# Where generated images are written (relative paths resolve inside the app dir)
OUTPUT_DIR=data/generations

# Optional: comma-separated tokens required in the X-Api-Key header. Empty = open.
API_KEYS=

# --- Provider credentials (only the selected provider's keys are needed) ---
REPLICATE_API_TOKEN=
REPLICATE_MODEL=black-forest-labs/flux-1.1-pro

STABILITY_API_KEY=
STABILITY_MODEL=sd3.5-large

OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
